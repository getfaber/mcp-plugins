{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/enforce-pre-tool-policy.sh\""
          }
        ]
      },
      {
        "matcher": "faber_attach_knowledge$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/enforce-pre-tool-policy.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch-companion.sh\" hook PostToolUse",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "faber_(publish_artifact|publish_status)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch-companion.sh\" hook PostToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch-companion.sh\" hook UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch-companion.sh\" hook PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch-companion.sh\" hook Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch-companion.sh\" hook SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
