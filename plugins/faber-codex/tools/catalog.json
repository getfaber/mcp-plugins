                          "applies_when": {
                            "type": "string",
                            "minLength": 1
                          },
                          "does_not_apply_when": {
                            "type": "string",
                            "minLength": 1
                          },
                          "detail_blocks": {
                            "default": [],
                            "maxItems": 12,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 80,
                                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
