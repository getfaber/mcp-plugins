                  "details": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "maxItems": 36,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  }
                },
                "required": [
                  "summary"
                ],
                "additionalProperties": {}
              },
              "categories": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "items": {
                      "minItems": 1,
