            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Publication URL returned by faber_publish_artifact."
          }
        },
        "required": [
          "publication_url"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "faber_recall",
      "title": "Recall the team's knowledge",
      "description": "Retrieve the team's most relevant saved knowledge (docs, decisions, skills, pipelines, dashboards) for a topic BEFORE you start working on it. Returns grounding context — summaries + relevant excerpts + artifact ids — not just links. Use it to avoid re-deriving what the team already knows, follow existing conventions, and cite prior work. If you build on a recalled artifact, pass its id as derived_from when saving.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1000,
            "description": "The topic or question to ground on, in natural language."
          },
          "k": {
            "default": 6,
            "description": "Max items.",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "faber_retry_context",
      "description": "Retry failed background context generation for an already completed local publication while its encrypted session handoff is still retained. This never republishes or versions the artifact.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "publication_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Publication URL returned by faber_publish_artifact."
          }
        },
        "required": [
          "publication_url"
        ]
      }
    },
    {
      "name": "faber_search",
      "title": "Search the Faber library",
      "description": "Search the team's library of saved AI artifacts. Use this BEFORE generating something the team may already have — dashboards, components, docs — and to find an artifact the user refers to by name or topic.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "What to look for, in natural language."
          },
          "limit": {
            "default": 5,
            "description": "Max results.",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
