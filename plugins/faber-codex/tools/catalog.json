                              ],
                              "additionalProperties": {}
                            }
                          },
                          "reusable_notes": {
                            "default": [],
                            "maxItems": 12,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
