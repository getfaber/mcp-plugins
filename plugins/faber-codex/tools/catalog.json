    {
      "name": "faber_context",
      "title": "Get grounding context for a task",
      "description": "Assemble a grounding pack for a task you're about to perform: the team's relevant prior artifacts, decisions, skills, and conventions. Call this at the START of a substantive task (building, writing, designing, debugging) with a one-line task description. Apply any recalled skills/conventions to your work, and save the result back to Faber with derived_from lineage.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1000,
            "description": "What you're about to do, in one line."
          }
        },
        "required": [
          "task"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "faber_get_artifact",
      "title": "Get artifact source from Faber",
      "description": "Fetch one accessible version of a Faber artifact with its source and shareable provenance. Accepts a UUID or pasted Faber URL; a URL with ?version=N always fetches that exact checkpoint. The separately attached Context Capsule is not returned by this tool. Use update_of when revising the same artifact and derived_from plus derived_from_version for distinct work.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Artifact UUID from Faber search, or a pasted Faber artifact URL."
          },
          "version": {
            "description": "Specific version; omit for current.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "faber_mark_used",
      "title": "Record artifact reuse",
      "description": "Record that an accessible Faber artifact materially influenced the current work.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "artifact_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "faber_publish_artifact",
      "title": "Publish artifact to Faber",
      "description": "Publish one completed local UTF-8 artifact file to Faber. Pass its absolute path in content_ref. Faber validates the file, resolves the workspace, stores an encrypted local snapshot, reserves a clickable URL, and returns that bare URL within 20 seconds without waiting for delivery. If workspace selection is required, ask the user to choose and call this tool again with workspace_name or workspace_slug. Do not prepare or pass context_capsule. Reports are private to the publishing user by default. For the main agent's initial successful complete or pending response, return only the bare Faber URL: no progress narration, label, recap, workspace or status prose, or Context note. Follow any returned context_action only after surfacing that URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Short human title. Omit to let Faber name it.",
            "type": "string",
            "maxLength": 300
          },
          "type": {
            "description": "Product class describing what the artifact is. Defaults to document.",
            "type": "string",
            "enum": [
              "document",
              "code",
              "application",
              "agent",
              "dataset",
              "prompt",
              "diagram",
              "other"
            ]
          },
          "model": {
            "description": "Exact generating model id when known.",
            "type": "string",
            "maxLength": 200
          },
          "conversation_ref": {
            "description": "URL or opaque id of the originating conversation.",
            "type": "string",
            "maxLength": 1000
          },
          "session_ref": {
            "description": "Stable session id when available.",
            "type": "string",
            "maxLength": 200
          },
          "external_ref": {
            "description": "Stable client id for this artifact so later saves append versions.",
            "type": "string",
            "maxLength": 500
          },
          "update_of": {
            "description": "Faber artifact id when the user asks to amend the same report.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "derived_from": {
            "description": "Parent artifact id when this is distinct work derived from prior work.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "derived_from_version": {
            "description": "Exact parent checkpoint version consumed when creating derived work.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "workspace_name": {
            "description": "Exact workspace name selected by the user when Faber asks where to publish.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "workspace_slug": {
            "description": "Workspace slug selected only when Faber reports duplicate workspace names.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Absolute path to one local UTF-8 artifact file of at most 20 MiB. For a newly generated artifact, default to a uniquely named file under ~/.faber/staging. For an existing artifact, pass its original path directly from any local directory. Faber stores an encrypted local outbox snapshot until delivery; it never moves, rewrites, changes permissions on, or deletes the source file. Do not pass directories, symlinks, credential locations, or files containing secrets."
          }
        },
        "required": [
          "content_ref"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "faber_publish_status",
      "title": "Check Faber publication",
      "description": "Check one local publication by the URL returned from faber_publish_artifact. This is for explicit status requests and diagnostics; the opened Faber page tracks pending delivery automatically.",
